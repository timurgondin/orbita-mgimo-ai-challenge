// Прототип на SQLite. Для PostgreSQL: provider = "postgresql" и новый DATABASE_URL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  login               String               @unique
  passwordHash        String
  pepperVersion       Int                  @default(1)
  role                String // student | teacher | staff
  lastName            String
  firstName           String
  middleName          String?
  faculty             String?
  program             String?
  course              Int?
  groupName           String?
  position            String?
  avatar              String               @default("sand") // ключ градиента аватара
  onboardingDone      Boolean              @default(false)
  createdAt           DateTime             @default(now())
  courseRank          Int? // место на курсе
  courseSize          Int? // студентов на курсе
  creditsEarned       Int? // кредитов в семестре
  // профиль: от университета (только чтение) и контакты (правит сам пользователь)
  degree              String? // «Бакалавриат»
  studyForm           String? // «Очная · бюджет»
  admissionYear       Int?
  graduationYear      Int?
  recordBook          String? // номер зачётной книжки
  curatorName         String?
  headmanName         String?
  phone               String?
  telegram            String?
  // студенческий билет: номер, срок, токен публичной проверки (/verify/<токен>, 32 байта CSPRNG)
  cardNumber          String?
  cardValidUntil      DateTime?
  cardToken           String?              @unique
  sessions            Session[]
  enrollments         Enrollment[]
  works               StudentWork[]
  onlineProgress      OnlineProgress[]
  notifications       Notification[]
  teaches             Course[]
  signups             ConsultationSignup[]
  consultationsHosted Consultation[]
  officeRequests      OfficeRequest[]
  documents           Document[]
  pastCourses         PastCourse[]
  assignmentWorks     AssignmentWork[]
  plannedCourses      PlannedCourse[]
}

model Session {
  id         String   @id // sha256(token) в hex
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Одна строка на неудачную попытку входа; key = "login|ip"
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---- Учёба. Значения-перечисления хранятся строками (типы — в src/server/data/types.ts) ----

model Course {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  color          String // ключ цвета: micro | econ | world | eng | law | hist | py
  format         String // offline | online
  assessment     String // exam | credit
  credits        Int
  kindsLabel     String           @default("")
  teacherName    String
  teacherAvatar  String           @default("sand")
  teacherId      String?
  teacher        User?            @relation(fields: [teacherId], references: [id])
  lessonsTotal   Int? // онлайн
  providerName   String? // онлайн
  syllabus       String? // JSON: программа дисциплины — аннотация, результаты, темы, литература, вопросы (src/server/data/types.ts, Syllabus)
  autoPassFrom   Float? // автомат: с какого текущего балла экзамен можно не сдавать
  autoPassRule   String? // условие автомата словами
  discipline     String? // строка в приложении к диплому, если дисциплина идёт несколько семестров («Иностранный язык (английский)»)
  staff          CourseTeacher[]
  assignments    Assignment[]
  enrollments    Enrollment[]
  components     GradeComponent[]
  events         ScheduleEvent[]
  consultations  Consultation[]
  onlineProgress OnlineProgress[]
}

model Enrollment {
  id       String @id @default(cuid())
  userId   String
  courseId String
  order    Int    @default(0)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// Элемент формулы оценки курса
model GradeComponent {
  id         String          @id @default(cuid())
  courseId   String
  title      String
  shortTitle String? // для карточки курса: «Эссе», «Case study»
  subtitle   String? // «домашнее задание», «15% оценки»…
  description String? // что сделать: абзацы через пустую строку, пункты списка — строки с «- »
  kind       String // test | homework | essay | project | exam | participation
  weight     Int // проценты
  dueAt      DateTime?
  room       String?
  order      Int             @default(0)
  aggregate  Boolean         @default(false) // балл — среднее по заданиям этого элемента («Домашние задания 20%»)
  course     Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  works      StudentWork[]
  events     ScheduleEvent[]
  assignments Assignment[]
}

// Состояние компонента у конкретного студента
model StudentWork {
  id             String         @id @default(cuid())
  userId         String
  componentId    String
  status         String // upcoming | draft | in_progress | submitted | reviewing | graded | returned
  score          Float?
  feedback       String?
  feedbackAuthor String?
  submittedAt    DateTime?
  gradedAt       DateTime?
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  component      GradeComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([userId, componentId])
}

// События курса видны записанным на курс. Время — по сетке звонков (src/lib/bells.ts)
model ScheduleEvent {
  id              String          @id @default(cuid())
  courseId        String?
  componentId     String?
  kind            String // lecture | seminar | practice | consultation | test
  title           String?
  pair            Int?
  startsAt        DateTime
  endsAt          DateTime
  room            String
  teacherName     String
  roomChangedFrom String?
  topic           String?
  groupName       String? // «МБ-24-1», у лекции — поток «МБ-24»
  course          Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  component       GradeComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([startsAt])
}

// ---- Задания и преподаватели ----

// Задание курса: что студент делает и сдаёт. componentId — в какой элемент формулы идёт балл; null — не входит в оценку
model Assignment {
  id          String           @id @default(cuid())
  courseId    String
  componentId String?
  title       String
  kind        String // homework | essay | test | project | practice
  description String? // абзацы через пустую строку, пункты — строки с «- »
  dueAt       DateTime?
  room        String? // пишется в аудитории
  upload      Boolean          @default(true) // сдаётся файлом
  order       Int              @default(0)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  component   GradeComponent?  @relation(fields: [componentId], references: [id], onDelete: SetNull)
  works       AssignmentWork[]

  @@index([courseId])
}

// Работа студента по заданию. Файл в прототипе не хранится — только имя и размер (интерфейс сдачи)
model AssignmentWork {
  id           String     @id @default(cuid())
  assignmentId String
  userId       String
  status       String // upcoming | draft | in_progress | submitted | reviewing | graded | returned
  score        Float?
  feedback     String?
  submittedAt  DateTime?
  gradedAt     DateTime?
  fileName     String?
  fileSize     Int?
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
}

// Преподаватель: публичная карточка (/people/<slug>). Вымышленные данные
model Teacher {
  id           String          @id @default(cuid())
  slug         String          @unique
  short        String          @unique // «Петрова Е. А.» — так имя записано в курсах и расписании
  lastName     String
  firstName    String
  middleName   String?
  avatar       String          @default("sand")
  position     String // «Доцент»
  department   String // «Кафедра экономики»
  degree       String? // «Кандидат экономических наук»
  email        String
  office       String? // «Каб. 518»
  bio          String?
  interests    String          @default("[]") // JSON string[]
  publications String          @default("[]") // JSON {title, venue, year}[]
  profiles     String          @default("[]") // JSON {kind, id, metric?}[]: orcid | scholar | elibrary | scopus | ssrn | site
  courses      CourseTeacher[]
}

model CourseTeacher {
  id        String  @id @default(cuid())
  courseId  String
  teacherId String
  role      String // Лекции | Семинары | Практика | Занятия
  order     Int     @default(0)
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseId, teacherId])
}

// Групповая консультация преподавателя: запись по курсу, лимит мест, вопрос заранее
model Consultation {
  id          String               @id @default(cuid())
  courseId    String
  teacherName String
  teacherId   String?
  startsAt    DateTime
  endsAt      DateTime
  pair        Int?
  place       String // «Каб. 518», «Онлайн»
  online      Boolean              @default(false)
  meetingUrl  String? // только на сервере; клиенту не отдаётся
  capacity    Int
  course      Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher     User?                @relation(fields: [teacherId], references: [id])
  signups     ConsultationSignup[]

  @@index([startsAt])
}

model ConsultationSignup {
  id             String       @id @default(cuid())
  consultationId String
  userId         String
  question       String?
  createdAt      DateTime     @default(now())
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([consultationId, userId])
}

// ---- Архив: дисциплины прошлых семестров. Отдельно от Course/Enrollment, чтобы не попадать в текущие экраны ----

// Сданная дисциплина: итог зафиксирован. semester — номер семестра обучения (1 — осень первого курса)
model PastCourse {
  id            String          @id @default(cuid())
  userId        String
  semester      Int
  title         String
  color         String // ключ цвета курса
  assessment    String // exam | credit
  credits       Int
  grade         Int? // итог по 10-балльной шкале; у зачёта — null
  passed        Boolean         @default(true)
  teacherName   String
  teacherAvatar String          @default("sand")
  closedAt      DateTime // дата экзамена или зачёта
  discipline    String? // строка в приложении к диплому, если дисциплина шла несколько семестров
  order         Int             @default(0)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  components    PastComponent[]

  @@index([userId, semester])
}

// Учебный план: дисциплины будущих семестров (для «Диплома» — что ещё впереди)
model PlannedCourse {
  id         String  @id @default(cuid())
  userId     String
  semester   Int
  title      String
  credits    Int
  assessment String // exam | credit
  discipline String?
  order      Int     @default(0)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, semester])
}

// Из чего сложился итог: элемент формулы и балл
model PastComponent {
  id           String     @id @default(cuid())
  pastCourseId String
  title        String
  weight       Int // проценты
  score        Float
  order        Int        @default(0)
  course       PastCourse @relation(fields: [pastCourseId], references: [id], onDelete: Cascade)

  @@index([pastCourseId])
}

model OnlineProgress {
  id                String @id @default(cuid())
  userId            String
  courseId          String
  lessonsDone       Int
  nextLessonTitle   String
  nextLessonMinutes Int
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  kind        String // grade | document | announcement | schedule | library | material | security | office — значок
  category    String    @default("study") // study | schedule | office | library | announcement | security — вкладки
  level       String    @default("info") // action (нужно действие) | important | info — docs/notifications.md
  title       String
  body        String // **выделение** в тексте
  link        String?
  actionLabel String? // действие прямо в строке: «Продлить», «Загрузить», «Скачать»
  actionKind  String? // resolve — выполняется на сервере и решает уведомление; link — ведёт на link
  dueAt       DateTime? // срок для «нужно действие»: ≤ 24 ч — полоса наверху «Сегодня»
  resolvedAt  DateTime? // «решено» ≠ «прочитано»: action висит, пока не решено
  refId       String? // связанный объект, напр. номер заявки «R-2481» — решается вместе с ним
  actorName   String?
  actorAvatar String?
  createdAt   DateTime
  readAt      DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---- Офис. Тип заявки — константа в src/lib/office-catalog.ts, в БД только его id ----

model OfficeRequest {
  id        String           @id @default(cuid())
  number    String           @unique // «R-2481»
  userId    String
  typeId    String
  params    String // JSON, проверен по каталогу
  status    String // sent | work | review | ready | done | rejected | withdrawn
  stage     Int // индекс текущего этапа; события до него выполнены
  eta       DateTime?
  // офис ждёт документ от студента: что нужно, до какого срока, когда получен
  needDoc        String?
  needDocDue     DateTime?
  docReceivedAt  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    RequestEvent[]
  messages  RequestMessage[]
  documents Document[]
  files     RequestFile[]

  @@index([userId, createdAt])
}

model RequestEvent {
  id        String        @id @default(cuid())
  requestId String
  order     Int
  title     String
  actorName String        @default("")
  note      String?
  at        DateTime? // null — этап ещё впереди
  request   OfficeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, order])
}

// Файл, загруженный студентом к заявке. Лежит вне public (storage/uploads) под случайным именем; отдаётся только офису (позже).
model RequestFile {
  id        String        @id @default(cuid())
  requestId String
  name      String // исходное имя, до 120 символов, только для показа
  size      Int
  mime      String // application/pdf | image/jpeg | image/png — по сигнатуре файла
  storedAs  String // случайное имя на диске
  createdAt DateTime      @default(now())
  request   OfficeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model RequestMessage {
  id         String        @id @default(cuid())
  requestId  String
  authorName String
  authorRole String // student | staff
  body       String // до 1000 символов
  createdAt  DateTime      @default(now())
  request    OfficeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

// Выданный документ. Содержимое — снимок на момент выдачи; verifyToken открывает публичную страницу /verify/<token>
model Document {
  id            String         @id @default(cuid())
  number        String         @unique // «D-2470»
  userId        String
  requestId     String?
  typeId        String // id из каталога: study | grades | …
  title         String
  subtitle      String
  holderDative  String // «Воронцовой Алисе Сергеевне»
  holderMask    String // «Воронцова А. С.» — единственное, что видно на публичной странице
  paragraphs    String // JSON: массив абзацев текста
  issuedAt      DateTime
  signedBy      String
  verifyToken   String         @unique
  status        String // ready | done
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  request       OfficeRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([userId, issuedAt])
}
